{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Pin tronweb to a single copy so our TronWeb instances stay assignable to
    // @b2binpay/defi-sdk's TronWeb-typed params. Without it TS resolves two
    // structurally-identical-but-nominally-distinct TronWeb types and rejects
    // the calls (TS2740). Required regardless of whether the SDK is a registry
    // or file: dependency.
    "paths": {
      "tronweb": ["./node_modules/tronweb"],
      "tronweb/*": ["./node_modules/tronweb/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
